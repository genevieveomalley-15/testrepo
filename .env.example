# ---------------------------------------------------------------------------
# Slack credentials
# Create an app at https://api.slack.com/apps (use the manifest in
# slack-app-manifest.json), then copy these from the app's settings.
# ---------------------------------------------------------------------------
# "Bot User OAuth Token" (OAuth & Permissions page) -> starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# "Signing Secret" (Basic Information page)
SLACK_SIGNING_SECRET=your-signing-secret
# "App-Level Token" with connections:write scope (Basic Information page)
# Required for Socket Mode -> starts with xapp-
SLACK_APP_TOKEN=xapp-your-app-token

# ---------------------------------------------------------------------------
# Salesforce credentials (Connected App, OAuth 2.0 Client Credentials flow)
# Your Salesforce admin creates a Connected App and enables the
# "Client Credentials Flow", assigning it a run-as integration user.
# See README.md -> "Salesforce setup" for step-by-step instructions.
# ---------------------------------------------------------------------------
# Your Salesforce instance / My Domain login URL
#   Production:  https://login.salesforce.com  (or https://<mydomain>.my.salesforce.com)
#   Sandbox:     https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com
# Connected App "Consumer Key" and "Consumer Secret"
SF_CLIENT_ID=your-connected-app-consumer-key
SF_CLIENT_SECRET=your-connected-app-consumer-secret

# ---------------------------------------------------------------------------
# Salesforce object + field mapping
# Change these to match the API names of YOUR custom object and fields.
# (Find them in Setup -> Object Manager. Custom names end in __c.)
# ---------------------------------------------------------------------------
# Object API name. "Asset Request" custom object -> Asset_Request__c
SF_OBJECT=Asset_Request__c
# Field API names on the Asset Request object.
SF_FIELD_DEMO_TYPE=Demo_Type__c
SF_FIELD_DEMO_TYPE_2=Demo_Type_2__c
SF_FIELD_PURPOSE=Purpose__c
SF_FIELD_PRODUCT=Product__c
SF_FIELD_MISSION=Mission_Set_Description__c
SF_FIELD_CUSTOM_WORK=Custom_Work_Needed__c
SF_FIELD_START_DATE=Start_Date__c
SF_FIELD_END_DATE=End_Date__c
# Optional: dedicated field for the selected state. If left blank, the state is
# prepended into Mission_Set_Description__c so it isn't lost. Set this to a real
# field API name (e.g. State__c) once you create one to store it cleanly.
SF_FIELD_STATE=

# Note: the requester is stored as the record's OwnerId. The submitting Slack
# user is matched to a Salesforce User by email, so Slack and Salesforce
# accounts must share the same email for this to resolve.

# Optional: port for the local health-check server (Socket Mode needs no public URL)
PORT=3000
