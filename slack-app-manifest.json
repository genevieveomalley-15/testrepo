{
  "display_information": {
    "name": "Product Request",
    "description": "Collects product requests and sends them to Salesforce.",
    "background_color": "#1f6feb"
  },
  "features": {
    "bot_user": {
      "display_name": "Product Request",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "New product request",
        "type": "global",
        "callback_id": "open_product_request",
        "description": "Open a form to request products"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["commands", "chat:write"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
