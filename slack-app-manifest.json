{
  "display_information": {
    "name": "Asset Request",
    "description": "Collects asset requests and sends them to Salesforce.",
    "background_color": "#1f6feb"
  },
  "features": {
    "bot_user": {
      "display_name": "Asset Request",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "New asset request",
        "type": "global",
        "callback_id": "open_asset_request",
        "description": "Open a form to request assets"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["commands", "chat:write", "users:read", "users:read.email"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
